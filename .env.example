# Frontend-safe Clerk key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Never expose this in Vite/client code. Keep it in a server/secret manager.
CLERK_SECRET_KEY=sk_test_your_key_here

# Optional future backend configuration
VITE_API_BASE_URL=http://localhost:8787

# Server-only secrets (do NOT put these in .env files used by Vite in production)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=8787
CORS_ORIGIN=http://localhost:5173
